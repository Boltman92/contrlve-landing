---
import SEO from "../components/SEO.astro";
import { GA_MEASUREMENT_ID } from "../consts";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
  organizationSchema?: boolean;
}

const seo = Astro.props;

// Production only, so local dev does not pollute the reports, and never on the
// admin pages, whose traffic is ours rather than the audience's.
const loadAnalytics =
  import.meta.env.PROD && !Astro.url.pathname.startsWith("/admin");
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="theme-color" content="#e5091a" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <SEO {...seo} />
    {
      loadAnalytics && (
        <>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}
          />
          {/* define:vars wraps this in a function, so gtag is assigned to
              window explicitly for page scripts to call. */}
          <script is:inline define:vars={{ id: GA_MEASUREMENT_ID }}>
            window.dataLayer = window.dataLayer || [];
            window.gtag = function () {
              dataLayer.push(arguments);
            };
            gtag("js", new Date());
            gtag("config", id);
          </script>
        </>
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  html {
    margin: 0;
    width: 100%;
    /* min-height, not height: with a fixed 100dvh box the background is sized
       to one viewport and tiles down a longer page. */
    min-height: 100%;
    min-height: 100dvh;
    background-color: #0a0a0a;
    background-image: url("/background.webp");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    /* Pins the image to the viewport so it never repeats or drifts while
       scrolling. If a browser ignores `fixed`, min-height above still grows the
       background box, so `cover` fills it rather than tiling. */
    background-attachment: fixed;
  }

  body {
    margin: 0;
    width: 100%;
    /* Also min-height, so a page taller than the viewport is not overflowing a
       fixed-height box. Pages that want an exact viewport set it themselves. */
    min-height: 100%;
    min-height: 100dvh;
  }
</style>
