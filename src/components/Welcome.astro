---
import logo from "../assets/logo.webp";
import myhal from "../assets/myhal.webp";
import andrienko from "../assets/andrienko.webp";
import yanovych from "../assets/yanovych.webp";
import razbeikov from "../assets/razbeikov.webp";
import Button from "./Button.astro";

const buttonHref = "https://www.youtube.com/playlist?list=PLLHZWI9bLm5mu2UvhLsH6l0CW0ejyKbCd";
const firstRule = [
  "Ведучий завжди правий",
  "На все воля організаторів",
  "Як сказав ведучий - так і буде",
  "В разі виникнення спірних питань, команді Антона Мигаля - мінус бал",
  "Якщо ображають ведучого, мінус бал",
  "Ведучий може змінити правила в будь який момент",
  "Ведучий може підказувати команді, яка йому подобається",
];
---

<main id="container">
  <div class="content">
    <div class="title">
      <h1>
        <img
          id="logo"
          src={logo.src}
          width={logo.width}
          height={logo.height}
          alt="ШОУ КОНТРЛВЕ"
          loading="eager"
        />
      </h1>
      <h2>офіційні правила</h2>
    </div>
    <div class="container">
      <ol class="rules">
        <li id="first-rule"></li>
        <li>поки все</li>
      </ol>
    </div>
    <Button href={buttonHref}>Дивитись</Button>
  </div>
  <div id="photos">
    <img class="photo" id="myhal" src={myhal.src} width={myhal.width} height={myhal.height} alt="Антон Мигаль — ШОУ КОНТРЛВЕ" loading="eager" />
    <img class="photo" id="andrienko" src={andrienko.src} width={andrienko.width} height={andrienko.height} alt="Дмитро Андрієнко — ШОУ КОНТРЛВЕ" loading="eager" />
    <img class="photo" id="yanovych" src={yanovych.src} width={yanovych.width} height={yanovych.height} alt="Євген Янович — ШОУ КОНТРЛВЕ" loading="eager" />
    <img class="photo" id="razbeikov" src={razbeikov.src} width={razbeikov.width} height={razbeikov.height} alt="Олександр Разбєйков — ШОУ КОНТРЛВЕ" loading="eager" />
  </div>
</main>

<script define:vars={{ firstRule }}>
  const el = document.getElementById("first-rule");
  if (el) {
    el.textContent = firstRule[Math.floor(Math.random() * firstRule.length)];
  }
</script>

<style>
  @font-face {
    font-family: Gothic;
    src: url("/SocialGothicBold.otf");
    font-display: swap;
  }
  #container {
    width: 100%;
    height: 100%;
    height: 100dvh;
    display: flex;
    flex-direction: center;
    align-items: center;
    font-size: clamp(32px, 5vw, 72px);
  }

  #logo {
    max-width: clamp(60px, 50vw, 200px);
    height: auto;
    aspect-ratio: 600 / 214;

    @media (max-width: 900px) {
      max-width: clamp(60px, 50vw, 180px);
    }
  }

  .content {
    flex: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-evenly;
    align-items: center;
    width: 100%;
  }

  .title {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: clamp(8px, 1.25vw, 48px);
    margin-top: clamp(24px, 1.875vw, 72px);
    font-family: Gothic;
    color: white;
  }

  /* Semantic headings that must not alter the existing visual layout. */
  .title h1,
  .title h2 {
    margin: 0;
    font-size: inherit;
    font-weight: inherit;
    line-height: 1;
  }

  .rules {
    font-family: Gothic;
    color: white;
    font-size: clamp(20px, 1.458vw, 56px);
  }

  .container {
    display: flex;
    justify-content: center;
    max-width: 70%;
  }

  #photos {
    display: flex;
    align-self: flex-end;
    width: 100%;
    flex: 1;
    justify-content: center;
    overflow: hidden;
    position: relative;
  }

  .photo {
    align-self: flex-end;
    width: 20%;
    height: auto;
    transform: translateY(45%);
    overflow: hidden;

    @media (max-width: 900px) {
      position: absolute;
    }
  }

  #yanovych {
    @media (max-width: 900px) {
      bottom: 0;
      right: clamp(5vw, 40px, 240px);
      width: 60%;
      transform: translate(0, 45%);
      z-index: 3;
    }
  }

  #razbeikov {
    transform: translate(-30%, 55%);

    @media (max-width: 900px) {
      bottom: 0;
      right: clamp(-10vw, -40px, -80px);
      width: 60%;
      transform: translate(0, 50%);
    }
  }

  #andrienko {
    transform: translate(30%, 40%);

    @media (max-width: 900px) {
      bottom: 0;
      left: clamp(10px, 5vw, 60px);
      width: 60%;
      transform: translate(0, 45%);
      z-index: 3;
    }
  }

  #myhal {
    transform: translate(60%, 45%);
    z-index: 2;

    @media (max-width: 900px) {
      bottom: 0;
      left: clamp(-70px, -10vw, -140px);
      width: 60%;
      transform: translate(0, 45%);
    }
  }

  main {
    flex: 1;
    height: 100%;
    height: 100dvh;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
</style>
